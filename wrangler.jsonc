{
  "name": "norx-crafting-movement",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/events/*"
    ]
  },
  "main": "src/events-worker.mjs",
  "vars": {
    "EVENTS_REGISTRATION_OPEN": "0"
  }
}
