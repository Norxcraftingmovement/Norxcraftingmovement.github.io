{
  "name": "norx-crafting-movement",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/events/*"
    ]
  },
  "main": "src/events-worker.mjs",
  "d1_databases": [
    { "binding": "EVENTS_DB", "database_name": "norx-events", "database_id": "7c78c89c-533e-43f1-9267-f0521a7068d5", "migrations_dir": "migrations/events" }
  ],
  "ratelimits": [
    { "name": "REGISTRATION_LIMITER", "namespace_id": "20261213", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "EVENTS_REGISTRATION_OPEN": "0"
  }
}
